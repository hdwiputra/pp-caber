<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>CaBer</h1>
    <a href="/logout">Logout</a>
    <table border="1">
        <tr>
            <th>Username</th>
            <th>Profile Picture</th>
        </tr>
        <% data.forEach(el => { %>
         <tr>
            <td><a href="/member/edit/<%= el.id %>"><%= el.username %></a></td>
            <td><img src="<%= el.imageUrl %>" alt="." style="height: 50px; aspect-ratio: 1; object-fit: cover;"></td>
         </tr>
        <% }) %>
    </table>
</body>
</html>