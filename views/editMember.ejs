<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Member</title>
</head>
<body>
    <h1>Edit Member</h1>

    <% if (error) { %>
        <% error = error.split(',') %>
        <% error.forEach(el => { %>
         <p style="color: red;"><%= el %></p>
        <% }) %>
       <% } %>

    <form method="post" action="/member/edit/<%= data.id %>" enctype="multipart/form-data">
        <label>Username</label><br>
        <input type="text" name="username" value="<%= data.username %>"><br><br>
    
        <label>Image</label><br>
        <input type="file" name="imageUrl"><br><br>
    
        <input type="submit" value="Update">
    </form>
</body>
</html>